{
  "rules": {
    ".read": false,
    ".write": false,
    
    "users": {
      ".read": "auth !== null && (auth.uid === $userId || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
      ".write": "auth !== null && auth.token.email_verified == true && (auth.uid === $userId || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
      "$userType": {
        "$userId": {
          ".read": "auth !== null && (auth.uid === $userId || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
          ".write": "auth !== null && (auth.uid === $userId || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "email": { ".validate": "newData.isString() && newData.val().matches(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)" },
          "mobile": { ".validate": "newData.isString() && newData.val().length === 10 && newData.val().matches(/^[6-9][0-9]{9}$/)" },
          "type": { ".validate": "newData.isString() && (newData.val() === 'client' || newData.val() === 'provider')" },
          "uid": { ".validate": "newData.isString() && newData.val().length > 0" },
          "emailVerified": { ".validate": "newData.isBoolean()" },
          "status": { ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'blocked')" },
          "services": { ".validate": "newData.isArray()" },
          "state": { ".validate": "newData.isString()" },
          "profilePhoto": { ".validate": "newData.isString() && newData.val().length < 1048576" },
          "createdAt": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    },
    
    "userEmails": {
      ".read": "auth !== null && (root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
      ".write": "auth !== null && !data.exists() && (!root.child('userEmails').child($userId).exists())",
      "$userId": {
        ".validate": "newData.hasChildren(['email', 'type', 'uid'])",
        "email": { ".validate": "newData.isString() && newData.val().matches(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)" },
        "type": { ".validate": "newData.isString() && (newData.val() === 'client' || newData.val() === 'provider')" },
        "uid": { ".validate": "newData.isString() && newData.val().length > 0" },
        "verified": { ".validate": "newData.isBoolean()" }
      }
    },
    
    "bookings": {
      ".read": "auth !== null && (root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
      ".write": "auth !== null && auth.token.email_verified == true",
      "$bookingId": {
        ".read": "auth !== null && (data.child('clientId').val() === auth.uid || data.child('providerId').val() === auth.uid || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
        ".write": "auth !== null && (data.child('clientId').val() === auth.uid || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['clientId', 'clientName', 'service', 'status', 'createdAt'])",
        "id": { ".validate": "newData.isString() && newData.val().length > 0" },
        "clientId": { ".validate": "newData.isString() && newData.val().length === 10" },
        "clientName": { ".validate": "newData.isString() && newData.val().length > 0" },
        "clientEmail": { ".validate": "newData.isString() && newData.val().matches(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)" },
        "service": { ".validate": "newData.isString() && newData.val().length > 0" },
        "serviceId": { ".validate": "newData.isNumber()" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'payment_pending' || newData.val() === 'submitted' || newData.val() === 'accepted' || newData.val() === 'completed' || newData.val() === 'cancelled')" },
        "paymentStatus": { ".validate": "newData.isString() && (newData.val() === 'pending_verification' || newData.val() === 'approved' || newData.val() === 'rejected')" },
        "paymentId": { ".validate": "newData.isString()" },
        "transactionId": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{12}$/)" },
        "paymentAmount": { ".validate": "newData.isNumber() && newData.val() >= 1" },
        "totalAmount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "showToProviders": { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isString()" },
        "bookingDate": { ".validate": "newData.isString()" },
        "bookingTime": { ".validate": "newData.isString()" },
        "address": { ".validate": "newData.isString()" },
        "pincode": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)" },
        "state": { ".validate": "newData.isString()" },
        "providerId": { ".validate": "newData.isString()" },
        "providerName": { ".validate": "newData.isString()" },
        "items": { ".validate": "newData.isArray()" },
        "completedAt": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },
    
    "clientBookings": {
      "$clientId": {
        ".read": "auth !== null && (auth.uid === $clientId || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
        ".write": "auth !== null && (auth.uid === $clientId || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())"
      }
    },
    
    "quotations": {
      "$bookingId": {
        ".read": "auth !== null && (root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
        ".write": "auth !== null && auth.token.email_verified == true",
        "$providerId": {
          ".read": "auth !== null && (auth.uid === $providerId || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
          ".write": "auth !== null && auth.uid === $providerId",
          ".validate": "newData.hasChildren(['bookingId', 'providerId', 'providerName', 'totalAmount', 'status'])",
          "id": { ".validate": "newData.isString()" },
          "bookingId": { ".validate": "newData.isString()" },
          "providerId": { ".validate": "newData.isString()" },
          "providerName": { ".validate": "newData.isString()" },
          "providerEmail": { ".validate": "newData.isString()" },
          "items": { ".validate": "newData.isArray()" },
          "totalAmount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "providerFee": { ".validate": "newData.isNumber()" },
          "status": { ".validate": "newData.isString() && (newData.val() === 'payment_pending' || newData.val() === 'submitted' || newData.val() === 'accepted' || newData.val() === 'not_accepted')" },
          "submittedAt": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    },
    
    "pendingPayments": {
      ".read": "auth !== null && (root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
      ".write": "auth !== null && auth.token.email_verified == true",
      "$paymentId": {
        ".read": "auth !== null && (data.child('userId').val() === auth.uid || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
        ".write": "auth !== null && (data.child('userId').val() === auth.uid || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['amount', 'status', 'userId'])",
        "amount": { ".validate": "newData.isNumber() && newData.val() >= 1" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'pending_verification' || newData.val() === 'verified' || newData.val() === 'rejected')" },
        "userId": { ".validate": "newData.isString()" },
        "userEmail": { ".validate": "newData.isString()" },
        "userName": { ".validate": "newData.isString()" },
        "userType": { ".validate": "newData.isString() && (newData.val() === 'client' || newData.val() === 'provider')" },
        "transactionId": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{12}$/)" },
        "transactionSubmittedAt": { ".validate": "newData.isString()" },
        "verifiedAt": { ".validate": "newData.isString()" },
        "verifiedBy": { ".validate": "newData.isString()" },
        "rejectedAt": { ".validate": "newData.isString()" },
        "rejectedBy": { ".validate": "newData.isString()" },
        "rejectionReason": { ".validate": "newData.isString()" },
        "metadata": { ".validate": "newData.isObject()" },
        "$other": { ".validate": false }
      }
    },
    
    "payments": {
      ".read": "auth !== null && (root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
      ".write": "auth !== null && (root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
      "$paymentId": {
        ".read": "auth !== null && (data.child('userId').val() === auth.uid || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['amount', 'status', 'userId'])",
        "amount": { ".validate": "newData.isNumber() && newData.val() >= 1" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'pending_verification' || newData.val() === 'approved' || newData.val() === 'rejected')" },
        "userId": { ".validate": "newData.isString()" },
        "userEmail": { ".validate": "newData.isString()" },
        "userName": { ".validate": "newData.isString()" },
        "userType": { ".validate": "newData.isString() && (newData.val() === 'client' || newData.val() === 'provider')" },
        "transactionId": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{12}$/)" },
        "verifiedAt": { ".validate": "newData.isString()" },
        "verifiedBy": { ".validate": "newData.isString()" },
        "rejectedAt": { ".validate": "newData.isString()" },
        "rejectedBy": { ".validate": "newData.isString()" },
        "rejectionReason": { ".validate": "newData.isString()" },
        "metadata": { ".validate": "newData.isObject()" },
        "$other": { ".validate": false }
      }
    },
    
    "userPayments": {
      "$userId": {
        ".read": "auth !== null && (auth.uid === $userId || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
        ".write": "auth !== null && (auth.uid === $userId || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())"
      }
    },
    
    "notifications": {
      "$userId": {
        ".read": "auth !== null && (auth.uid === $userId || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
        ".write": "auth !== null && (auth.uid === $userId || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())"
      }
    },
    
    "complaints": {
      ".read": "auth !== null && (root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
      ".write": "auth !== null && auth.token.email_verified == true",
      "$complaintId": {
        ".read": "auth !== null && (data.child('userId').val() === auth.uid || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
        ".write": "auth !== null && (data.child('userId').val() === auth.uid || root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['userId', 'userName', 'subject', 'description', 'status', 'createdAt'])",
        "id": { ".validate": "newData.isString()" },
        "userId": { ".validate": "newData.isString()" },
        "userName": { ".validate": "newData.isString()" },
        "userEmail": { ".validate": "newData.isString()" },
        "userType": { ".validate": "newData.isString()" },
        "subject": { ".validate": "newData.isString() && newData.val().length > 0" },
        "description": { ".validate": "newData.isString() && newData.val().length > 0" },
        "screenshot": { ".validate": "newData.isString()" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'solved')" },
        "createdAt": { ".validate": "newData.isString()" },
        "resolvedAt": { ".validate": "newData.isString()" },
        "resolvedBy": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },
    
    "services": {
      ".read": "auth !== null",
      ".write": "auth !== null && (root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
      "$serviceId": {
        ".validate": "newData.hasChildren(['name', 'icon', 'description'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0" },
        "icon": { ".validate": "newData.isString()" },
        "description": { ".validate": "newData.isString()" }
      }
    },
    
    "admin": {
      ".read": "auth !== null && (root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
      ".write": "auth !== null && (root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
      "upiId": { ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9._-]+@[a-zA-Z0-9]+$/)" },
      "defaultFee": { ".validate": "newData.isNumber() && newData.val() >= 1" },
      "$other": { ".validate": false }
    },
    
    "adminEmails": {
      ".read": "auth !== null && root.child('adminEmails').child(auth.uid).exists()",
      ".write": "auth !== null && root.child('adminEmails').child(auth.uid).child('role').val() === 'super'",
      "$adminId": {
        ".validate": "newData.hasChildren(['email', 'role', 'uid'])",
        "email": { ".validate": "newData.isString() && newData.val().matches(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)" },
        "role": { ".validate": "newData.isString() && (newData.val() === 'super' || newData.val() === 'sub')" },
        "uid": { ".validate": "newData.isString() && newData.val().length > 0" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'blocked')" }
      }
    },
    
    "subAdmins": {
      ".read": "auth !== null && root.child('adminEmails').child(auth.uid).exists()",
      ".write": "auth !== null && root.child('adminEmails').child(auth.uid).child('role').val() === 'super'",
      "$subAdminId": {
        ".validate": "newData.hasChildren(['email', 'username', 'permissions', 'status', 'uid'])",
        "email": { ".validate": "newData.isString() && newData.val().matches(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)" },
        "username": { ".validate": "newData.isString() && newData.val().length > 0" },
        "permissions": { ".validate": "newData.isObject()" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'blocked')" },
        "createdAt": { ".validate": "newData.isString()" },
        "uid": { ".validate": "newData.isString() && newData.val().length > 0" },
        "$other": { ".validate": false }
      }
    },
    
    "rateLimits": {
      ".read": "auth !== null && (root.child('adminEmails').child(auth.uid).exists() || root.child('subAdmins').child(auth.uid).exists())",
      ".write": "auth !== null && (auth.uid === $key || root.child('adminEmails').child(auth.uid).exists())",
      "$key": {
        "count": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "lastAttempt": { ".validate": "newData.isNumber()" }
      }
    },
    
    "superAdmin": {
      ".read": "auth !== null && root.child('adminEmails').child(auth.uid).exists()",
      ".write": "auth !== null && root.child('adminEmails').child(auth.uid).child('role').val() === 'super'",
      "$key": { ".validate": false }
    }
  }
}